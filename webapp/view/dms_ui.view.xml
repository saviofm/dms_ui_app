<mvc:View controllerName="dmsuiapp.controller.dms_ui"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">
    <Page id="page" title="{i18n>title}">
        <content>
            <core:ComponentContainer
                id="sdi-container"
                usage="documentTable"
                height="100%"
                width="100%"
                async="true"
                manifest="true"/>
        </content>
    </Page>
</mvc:View>
