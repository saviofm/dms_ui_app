{
  "welcomeFile": "/dmsuiapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/api(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "service": "com.sap.ecm.reuse",
      "endpoint": "ecmservice"
    },
    {
      "source": "^/sap/bc/lrep/(.*)$",
      "target": "/sap/bc/lrep/$1",
      "authenticationType": "none",
      "destination": "ui5"
    },
    {
      "source": "^/comsapecmreuse.comsapecmreusedocumentTable-1.0.0/(.*)$",
      "target": "/comsapecmreuse.comsapecmreusedocumentTable-1.0.0/$1",
      "destination": "dmsuiapp_html_repo_host",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/comsapecmreuse.comsapecmreuseadmin-1.0.0/(.*)$",
      "target": "/comsapecmreuse.comsapecmreuseadmin-1.0.0/$1",
      "destination": "dmsuiapp_html_repo_host",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "destination": "dmsuiapp_html_repo_host",
      "authenticationType": "xsuaa"
    }
  ]
}
